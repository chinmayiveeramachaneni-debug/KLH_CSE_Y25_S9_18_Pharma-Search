import java.io.PrintStream;
import java.util.ArrayList;
import java.util.LinkedList;
import java.util.Scanner;

public class PharmaSearchStringMatching {
   static Scanner sc;
   static Medicine[] medicines;

   public PharmaSearchStringMatching() {
   }

   static Medicine findMedicine(String var0) {
      for(Medicine var4 : medicines) {
         if (var4.name.equalsIgnoreCase(var0.trim())) {
            return var4;
         }
      }

      return null;
   }

   static int[] buildLPS(String var0) {
      int[] var1 = new int[var0.length()];
      int var2 = 0;
      int var3 = 1;

      while(var3 < var0.length()) {
         if (Character.toLowerCase(var0.charAt(var3)) == Character.toLowerCase(var0.charAt(var2))) {
            int var10001 = var3++;
            ++var2;
            var1[var10001] = var2;
         } else if (var2 > 0) {
            var2 = var1[var2 - 1];
         } else {
            var1[var3++] = 0;
         }
      }

      return var1;
   }

   static ArrayList<Integer> KMPSearch(String var0, String var1) {
      ArrayList var2 = new ArrayList();
      if (var1 != null && !var1.isEmpty()) {
         int[] var3 = buildLPS(var1);
         int var4 = 0;
         int var5 = 0;

         while(var4 < var0.length()) {
            if (Character.toLowerCase(var0.charAt(var4)) == Character.toLowerCase(var1.charAt(var5))) {
               ++var4;
               ++var5;
            }

            if (var5 == var1.length()) {
               var2.add(var4 - var5);
               var5 = var3[var5 - 1];
            } else if (var4 < var0.length() && Character.toLowerCase(var0.charAt(var4)) != Character.toLowerCase(var1.charAt(var5))) {
               if (var5 > 0) {
                  var5 = var3[var5 - 1];
               } else {
                  ++var4;
               }
            }
         }

         return var2;
      } else {
         return var2;
      }
   }

   static String medicineNamesText() {
      StringBuilder var0 = new StringBuilder();

      for(Medicine var4 : medicines) {
         var0.append(var4.name).append("\n");
      }

      return var0.toString();
   }

   static void printMedicineDetails(Medicine var0) {
      System.out.println("\n===== MEDICINE DETAILS =====");
      System.out.println("Medicine Name : " + var0.name);
      System.out.println("Category      : " + var0.category);
      System.out.println("Uses          : " + var0.uses);
      System.out.println("Problems      : " + var0.problems);
      System.out.println("Dosage        : " + var0.dosage);
      System.out.println("Side Effects  : " + var0.sideEffects);
      System.out.println("Precautions   : " + var0.precautions);
      System.out.println("Stock         : " + var0.stock + " units");
      if (var0.stock > 0) {
         System.out.println("Availability  : IN STOCK");
      } else {
         System.out.println("Availability  : OUT OF STOCK");
         System.out.println("Possible alternatives to discuss:");
