      }

      System.out.println("\nIMPORTANT: Alternatives are informational only.");
      System.out.println("Ask a doctor or pharmacist before substituting any medicine.");
   }

   static int editDistance(String var0, String var1) {
      var0 = var0.toLowerCase();
      var1 = var1.toLowerCase();
      int[][] var2 = new int[var0.length() + 1][var1.length() + 1];

      for(int var3 = 0; var3 <= var0.length(); var2[var3][0] = var3++) {
      }

      for(int var7 = 0; var7 <= var1.length(); var2[0][var7] = var7++) {
      }

      for(int var8 = 1; var8 <= var0.length(); ++var8) {
         for(int var4 = 1; var4 <= var1.length(); ++var4) {
            if (var0.charAt(var8 - 1) == var1.charAt(var4 - 1)) {
               var2[var8][var4] = var2[var8 - 1][var4 - 1];
            } else {
               var2[var8][var4] = 1 + Math.min(var2[var8 - 1][var4], Math.min(var2[var8][var4 - 1], var2[var8 - 1][var4 - 1]));
            }
         }
      }

      return var2[var0.length()][var1.length()];
   }

   static void checkSpelling(String var0) {
      String var1 = "";
      int var2 = Integer.MAX_VALUE;

      for(Medicine var6 : medicines) {
         int var7 = editDistance(var0, var6.name);
         if (var7 < var2) {
            var2 = var7;
            var1 = var6.name;
         }
      }

      System.out.println("\n===== EDIT DISTANCE =====");
      System.out.println("Entered : " + var0);
      System.out.println("Closest : " + var1.toLowerCase());
      System.out.println("Distance: " + var2);
      if (var2 == 0) {
         System.out.println("Status  : Correct spelling");
      } else if (var2 <= 3) {
         System.out.println("Status  : Possible spelling mistake");
      } else {
         System.out.println("Status  : No close medicine found");
      }

   }

   static boolean bfs(int[][] var0, int var1, int var2, int[] var3) {
      boolean[] var4 = new boolean[var0.length];
      LinkedList var5 = new LinkedList();
      var5.add(var1);
      var4[var1] = true;
      var3[var1] = -1;

      while(!var5.isEmpty()) {
         int var6 = (Integer)var5.poll();

         for(int var7 = 0; var7 < var0.length; ++var7) {
            if (!var4[var7] && var0[var6][var7] > 0) {
               var5.add(var7);
               var3[var7] = var6;
               var4[var7] = true;
            }
         }
      }

      return var4[var2];
   }

   static int maxFlow(int[][] var0, int var1, int var2) {
      int var3 = var0.length;
      int[][] var4 = new int[var3][var3];

      for(int var5 = 0; var5 < var3; ++var5) {
         var4[var5] = (int[])var0[var5].clone();
      }

      int[] var10 = new int[var3];

      int var6;
      int var7;
      for(var6 = 0; bfs(var4, var1, var2, var10); var6 += var7) {
         var7 = Integer.MAX_VALUE;

         for(int var8 = var2; var8 != var1; var8 = var10[var8]) {
            var7 = Math.min(var7, var4[var10[var8]][var8]);
         }

         for(int var11 = var2; var11 != var1; var11 = var10[var11]) {
            int var9 = var10[var11];
            var4[var9][var11] -= var7;
            var4[var11][var9] += var7;
         }
      }

      return var6;
   }

   static void networkFlow() {
      int[][] var0 = new int[][]{{0, 100, 0, 0, 0}, {0, 0, 80, 20, 0}, {0, 0, 0, 60, 0}, {0, 0, 0, 0, 70}, {0, 0, 0, 0, 0}};
      System.out.println("\n===== NETWORK FLOW =====");
      System.out.println("Source -> Supplier -> Pharmacy -> Patient -> Sink");
      System.out.println("Maximum Medicine Flow: " + maxFlow(var0, 0, 4) + " units");
      System.out.println("Algorithm: Ford-Fulkerson");
   }

   static void naiveSearch(String var0, String var1) {
      int var2 = 0;
      if (var1.isEmpty()) {
         System.out.println("Please enter a search term.");
      } else {
         for(int var3 = 0; var3 <= var0.length() - var1.length(); ++var3) {
            if (var0.regionMatches(true, var3, var1, 0, var1.length())) {
               ++var2;
            }
         }

         System.out.println("\n===== NAIVE STRING MATCHING =====");
         System.out.println("Query: " + var1);
         System.out.println("Matches Found: " + var2);
         System.out.println(var2 > 0 ? "Status: MATCH FOUND" : "Status: NO MATCH FOUND");
      }
   }

   static int lcsLength(String var0, String var1) {
      int[][] var2 = new int[var0.length() + 1][var1.length() + 1];

      for(int var3 = 1; var3 <= var0.length(); ++var3) {
         for(int var4 = 1; var4 <= var1.length(); ++var4) {
            if (Character.toLowerCase(var0.charAt(var3 - 1)) == Character.toLowerCase(var1.charAt(var4 - 1))) {
               var2[var3][var4] = var2[var3 - 1][var4 - 1] + 1;
            } else {
               var2[var3][var4] = Math.max(var2[var3 - 1][var4], var2[var3][var4 - 1]);
            }
         }
      }

      return var2[var0.length()][var1.length()];
   }

   static void compareMedicines() {
      System.out.print("Enter first medicine name: ");
      String var0 = sc.nextLine();
      System.out.print("Enter second medicine name: ");
      String var1 = sc.nextLine();
      System.out.println("\n===== LCS COMPARISON =====");
      System.out.println("First Medicine : " + var0);
      System.out.println("Second Medicine: " + var1);
      PrintStream var10000 = System.out;
      int var10001 = lcsLength(var0, var1);
      var10000.println("Common subsequence length: " + var10001);
   }

   static void displayMedicines() {
      System.out.println("\n===== AVAILABLE MEDICINES =====");

      for(Medicine var3 : medicines) {
         System.out.printf("%-18s Stock: %d%n", var3.name, var3.stock);
      }

      System.out.println("Total Medicines: " + medicines.length);
   }

   public static void main(String[] var0) {
      while(true) {
         System.out.println("\n==============================");
         System.out.println("        PHARMA SEARCH");
         System.out.println("==============================");
         System.out.println("1. Search Medicine using KMP");
         System.out.println("2. Check Spelling using Edit Distance");
         System.out.println("3. Calculate Network Flow");
         System.out.println("4. Search using Naive String Matching");
         System.out.println("5. Compare Medicines using LCS");
         System.out.println("6. Display All Available Medicines");
         System.out.println("0. Exit");
         System.out.println("==============================");
         System.out.print("Enter choice: ");
         switch (sc.nextLine().trim()) {
            case "1":
               System.out.print("Enter medicine or keyword: ");
               String var12 = sc.nextLine().trim();
               ArrayList var13 = KMPSearch(medicineNamesText(), var12);
               System.out.println("\n===== KMP SEARCH =====");
               System.out.println("Query: " + var12);
               System.out.println("Matches Found: " + var13.size());
               if (var13.isEmpty()) {
                  System.out.println("Status: NO MATCH FOUND");
                  checkSpelling(var12);
                  System.out.println("Use option 2 for spelling suggestions.");
               } else {
                  System.out.println("Status: MATCH FOUND");
                  boolean var6 = false;

                  for(Medicine var10 : medicines) {
                     if (var10.name.toLowerCase().contains(var12.toLowerCase())) {
                        printMedicineDetails(var10);
                        var6 = true;
                     }
                  }

                  if (!var6) {
                     System.out.println("For full details, enter the complete medicine name.");
                  }
               }
               break;
            case "2":
               System.out.print("Enter medicine name: ");
               checkSpelling(sc.nextLine().trim());
               break;
            case "3":
               networkFlow();
               break;
            case "4":
               System.out.print("Enter medicine or keyword: ");
               String var11 = sc.nextLine().trim();
               naiveSearch(medicineNamesText(), var11);
               break;
            case "5":
               compareMedicines();
               break;
            case "6":
               displayMedicines();
               System.out.print("\nEnter a medicine name to view details, or press Enter to return: ");
               String var4 = sc.nextLine().trim();
               if (var4.isEmpty()) {
                  break;
               }

               Medicine var5 = findMedicine(var4);
               if (var5 != null) {
                  printMedicineDetails(var5);
                  break;
               }

               System.out.println("Medicine not found in this sample database.");
               break;
            case "0":
               System.out.println("Thank you for using Pharma Search!");
               sc.close();
               return;
            default:
               System.out.println("Invalid choice. Try again.");
         }
      }
   }

